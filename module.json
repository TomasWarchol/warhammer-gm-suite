{
  "id": "warhammer-gm-suite",
  "title": "Warhammer GM Suite",
  "description": "One GM dashboard for every Warhammer system (WFRP 4e/5e, The Old World, Imperium Maledictum, Wrath & Glory, Soulbound): session turnover, secret group tests, damage for several characters, combat pools, light and vision presets, Dark Whispers and tests on the Token HUD, adapted to the active system.",
  "version": "0.3.1",
  "compatibility": {
    "minimum": "14",
    "verified": "14",
    "maximum": "14"
  },
  "authors": [
    {
      "name": "Tomek (TomasWarchol)",
      "url": "https://github.com/TomasWarchol",
      "discord": "tomek"
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "wfrp4e",
        "type": "system",
        "compatibility": {
          "minimum": "10.0.0"
        }
      },
      {
        "id": "whtow",
        "type": "system",
        "compatibility": {
          "minimum": "1.3.0"
        }
      },
      {
        "id": "impmal",
        "type": "system",
        "compatibility": {
          "minimum": "4.0.0"
        }
      },
      {
        "id": "wrath-and-glory",
        "type": "system",
        "compatibility": {
          "minimum": "8.0.0"
        }
      },
      {
        "id": "age-of-sigmar-soulbound",
        "type": "system",
        "compatibility": {
          "minimum": "9.0.0"
        }
      }
    ]
  },
  "esmodules": [
    "scripts/main.mjs"
  ],
  "styles": [
    "styles/warhammer-gm-suite.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "pl",
      "name": "Polski",
      "path": "lang/pl.json"
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "hbs",
        "json"
      ]
    }
  },
  "url": "https://github.com/TomasWarchol/warhammer-gm-suite",
  "manifest": "https://github.com/TomasWarchol/warhammer-gm-suite/releases/latest/download/module.json",
