<section class="tab {{tab.cssClass}}" data-tab="merchants" data-group="main">
  <fieldset>
    <legend>{{localize "WHGM.Merchants.Title"}}</legend>
    <p class="hint">{{localize "WHGM.Merchants.Hint"}}</p>
    {{#each merchantRows}}
      <div class="whgm-merchant" data-actor="{{id}}">
        <img src="{{img}}" alt="">
        <span>{{name}}</span>
        <button type="button" data-action="stockMerchant"><i class="fa-solid fa-cart-plus"></i> {{localize "WHGM.Merchants.Stock"}}</button>
      </div>
    {{else}}
      <p class="hint">{{localize "WHGM.Merchants.None"}}</p>
    {{/each}}
  </fieldset>
</section>
